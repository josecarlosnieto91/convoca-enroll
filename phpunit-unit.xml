<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         backupGlobals="false"
         colors="true"
         cacheResult="false">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
      <exclude>tests/Unit/BlogPostManagerTest.php</exclude>
      <exclude>tests/Unit/MediaLoggerTest.php</exclude>
      <exclude>tests/Unit/PosterEngineTest.php</exclude>
      <exclude>tests/Unit/QRGeneratorTest.php</exclude>
      <exclude>tests/Unit/SocialSchedulerTest.php</exclude>
      <exclude>tests/Unit/TemplateManagerTest.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
