<?xml version="1.0" encoding="UTF-8"?>
<!-- PHPUnit 10.5 desde el 21-10-2026. Antes 9.6, y no por gusto: `wp-phpunit` usaba
     `PHPUnit\Util\Test::parseTestMethodAnnotations()` y `getName()`, eliminados en 10.x, y la suite de
     integración reventaba con 29 errores que parecían del código. La solución no fue esperar a WordPress:
     fue dejar de heredar de `WP_UnitTestCase` (ver tests/IntegrationTestCase.php).

     Este fichero es el de la suite UNITARIA y el que mide la cobertura, con el filtro sobre el código
     real del plugin: includes/ (8.931 líneas) + admin/ (6.997) + media/. Antes los tests corrían con
     `phpunit-unit.xml` y la cobertura con este: dos configuraciones para lo mismo, y de ahí salió el 0 %
     que ya conocemos. `phpunit-unit.xml` ya no existe. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap-unit.php"
         defaultTestSuite="unit"
         backupGlobals="false"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">./includes</directory>
      <directory suffix=".php">./admin</directory>
      <directory suffix=".php">./media</directory>
    </include>
  </source>
</phpunit>
