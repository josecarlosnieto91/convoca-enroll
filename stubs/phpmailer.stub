<?php
/**
 * PHPMailer que trae WordPress: solo lo que usa Convoca.
 *
 * `wp_mail()` entrega una instancia de esta clase en `phpmailer_init`; el stub existe para poder
 * comprobar el tipo sin depender de que el core esté en el checkout de CI.
 */

namespace PHPMailer\PHPMailer;

class PHPMailer {
	/**
	 * Añade un adjunto desde una cadena.
	 *
	 * @param string $string      Contenido.
	 * @param string $filename    Nombre.
	 * @param string $encoding    Codificación.
	 * @param string $type        Tipo MIME.
	 * @param string $disposition Disposición.
	 * @return void
	 */
	public function addStringAttachment( $string, $filename, $encoding = 'base64', $type = 'application/octet-stream', $disposition = 'attachment' ) {}

	/**
	 * Incrusta una imagen en el cuerpo con su `Content-ID` (la referencia `cid:`).
	 *
	 * @param string $path        Ruta del fichero.
	 * @param string $cid         Content-ID.
	 * @param string $name        Nombre visible.
	 * @param string $encoding    Codificación.
	 * @param string $type        Tipo MIME.
	 * @param string $disposition Disposición.
	 * @return bool
	 */
	public function addEmbeddedImage( $path, $cid, $name = '', $encoding = 'base64', $type = 'application/octet-stream', $disposition = 'inline' ) {}
}
