<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suite de INTEGRACIÓN de convoca-enroll: necesita WordPress real (base de datos de pruebas).

  Configuración aparte de phpunit.xml.dist a propósito: el bootstrap unitario no carga WordPress y con él
  esta suite no arrancaría. Aquí el bootstrap es tests/bootstrap-integration.php, que carga la biblioteca
  de pruebas de WordPress (WP_TESTS_DIR), arranca el sitio y ejecuta la activación del plugin —donde se
  crean sus tablas—. Si no hay entorno, los casos se declaran SALTADOS con su motivo y el CI los cuenta.

  Los casos extienden `IntegrationTestCase` (tests/IntegrationTestCase.php), NO `WP_UnitTestCase`: eso es
  lo que permite correr en PHPUnit 10.5.

  Uso:  CONVOCA_WP_ROOT=… WP_TESTS_DIR=… WP_TESTS_CONFIG_FILE_PATH=… vendor/bin/phpunit -c phpunit-integration.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap-integration.php"
         backupGlobals="false"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">./tests/Integration</directory>
    </testsuite>
  </testsuites>
</phpunit>
