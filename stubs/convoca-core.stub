    public static function acquire_lock( mixed ...$args ): mixed { return null; }
    public static function release_lock( mixed ...$args ): void {}
    public static function is_plugin_active_safe( mixed ...$args ): mixed { return null; }
    public static function get_logo_url( mixed ...$args ): mixed { return null; }
    public static function admin_notice( mixed ...$args ): void {}
    public static function rest_cache_get( mixed ...$args ): mixed { return null; }
    public static function render_stored_notices( mixed ...$args ): void {}
    public static function render_log_level_badge( mixed ...$args ): mixed { return null; }
    public static function render_diagnostic_panel( mixed ...$args ): mixed { return null; }
    public static function get_persistent_salt( mixed ...$args ): mixed { return null; }
    public static function get_aportacion_label( mixed ...$args ): mixed { return null; }
