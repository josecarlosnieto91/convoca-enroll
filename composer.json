{
    "name": "convoca/enroll",
    "license": "GPL-2.0-or-later",
    "description": "Plugin de inscripcion para Convoca",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "chillerlan/php-qrcode": "^6.0",
        "eluceo/ical": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "Convoca\\Enroll\\": "includes/"
        },
        "classmap": [
            "admin/",
            "media/",
            "social/",
            "public/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.4",
        "php-stubs/wordpress-stubs": "^7.0",
        "phpunit/phpunit": "^9.6",
        "phpstan/extension-installer": "^1.4",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "phpcs": "phpcs --standard=.phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=4G",
        "phpunit": "phpunit",
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ],
        "phpunit:integration": "phpunit -c phpunit-integration.xml"
    }
}