{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "convoca-enroll/formulario-inscripcion",
    "version": "1.0.0",
    "title": "Formulario de Inscripción Convoca",
    "category": "convoca-enroll",
    "icon": "clipboard",
    "description": "Formulario de inscripción dinámico vinculado a una actividad.",
    "keywords": ["convoca", "
        "inscripción",
        "actividad",
        "formulario",
        "biodevas"
    ],
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "attributes": {
        "actividadId": {
            "type": "number",
            "default": 0
        },
        "mostrarPlazas": {
            "type": "boolean",
            "default": true
        },
        "mostrarPrecios": {
            "type": "boolean",
            "default": true
        }
    },
    "textdomain": "convoca-enroll",
    "editorScript": "biodevas-enroll-blocks"
}